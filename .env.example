# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=finpilot
# Host port for the Docker Postgres (5433 avoids clashing with a local install on 5432)
POSTGRES_PORT=5433

# --- API ---
DATABASE_URL=postgres://finpilot:change-me-local-only@localhost:5433/finpilot?sslmode=disable
API_PORT=3000
LOG_LEVEL=info
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Origin the browser app is served from (CORS)
WEB_ORIGIN=http://localhost:5173

# --- Web ---
# The Vite dev server proxies /api to this URL
VITE_API_PROXY_TARGET=http://localhost:3000

# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=finpilot
# Host port for the Docker Postgres (5433 avoids clashing with a local install on 5432)
POSTGRES_PORT=5433

# --- API ---
DATABASE_URL=postgres://finpilot:change-me-local-only@localhost:5433/finpilot?sslmode=disable
# Separate database used by the automated tests (created and migrated automatically)
TEST_DATABASE_URL=postgres://finpilot:change-me-local-only@localhost:5433/finpilot_test?sslmode=disable
API_PORT=3000
LOG_LEVEL=info
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Mark the session cookie Secure (set true when served over HTTPS)
COOKIE_SECURE=false
# Origin the browser app is served from (CORS)
WEB_ORIGIN=http://localhost:5173

# --- Demo users created by `pnpm db:seed` (local demo only) ---
# viewer@finpilot.test (VIEWER) and admin@finpilot.test (ADMIN)
SEED_VIEWER_PASSWORD=viewer-demo-2026
SEED_ADMIN_PASSWORD=admin-demo-2026

# --- Web ---
# The Vite dev server proxies /api to this URL
VITE_API_PROXY_TARGET=http://localhost:3000

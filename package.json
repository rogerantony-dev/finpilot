{
  "name": "finpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @finpilot/api db:migrate",
    "db:rollback": "pnpm --filter @finpilot/api db:rollback",
    "db:seed": "pnpm --filter @finpilot/api db:seed",
    "db:codegen": "pnpm --filter @finpilot/api db:codegen",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && pnpm db:migrate && pnpm db:seed",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api web",
    "stack:smoke": "scripts/smoke-test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}

{
  "name": "finpilot-architecture-report",
  "private": true,
  "type": "module",
  "description": "Builds docs/architecture-report.docx (and .pdf) from the diagram sources in docs/diagrams.",
  "scripts": {
    "diagrams": "node render-diagrams.mjs",
    "build": "node build-report.mjs",
    "pdf": "\"/Applications/LibreOffice.app/Contents/MacOS/soffice\" --headless --convert-to pdf --outdir .. ../architecture-report.docx"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "docx": "^9.7.2"
  }
}

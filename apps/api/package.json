{
  "name": "@finpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "dbmate --env-file ../../.env --migrations-dir ../../db/migrations --no-dump-schema --wait up",
    "db:rollback": "dbmate --env-file ../../.env --migrations-dir ../../db/migrations --no-dump-schema rollback",
    "db:status": "dbmate --env-file ../../.env --migrations-dir ../../db/migrations --no-dump-schema status",
    "db:codegen": "kysely-codegen --env-file ../../.env --dialect postgres --date-parser string --numeric-parser string --out-file src/db/schema.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/seed/seed.ts",
    "db:seed:prod": "node dist/seed/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@finpilot/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "dbmate": "^2.37.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
